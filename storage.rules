rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function canAccessConferenceTranscript(confId) {
      return request.auth != null
        && (
          request.auth.token.globalRole == "super_admin"
          || firestore.get(
            /databases/(default)/documents/conferences/$(confId)/members/$(request.auth.uid)
          ).data.status == "approved"
        );
    }

    match /published-reports/{allPaths=**} {
      allow read;
      allow write: if request.auth != null;
    }

    match /illustrations/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /sitePhotos/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Legacy ConferenceReport summary uploads; kept explicit so it cannot grant transcript access.
    match /public/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /conference-transcripts/{confId}/{reportId}/{sessionId}/{fileName} {
      allow read, write: if canAccessConferenceTranscript(confId);
    }

    match /conference-transcripts/{confId}/{reportId}/blocks/{targetFieldId}/{blockId}/{fileName} {
      allow read, write: if canAccessConferenceTranscript(confId);
    }
  }
}
